.container {
  padding: 32px;
  font-family: 'Inter', sans-serif;
  background-color: #fff7e6;
  min-height: 100vh;
  color: #42311d;
}

.headerCard {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  padding: 28px;
  background: #fff5d6;
  border: 1px solid rgba(252, 191, 73, 0.22);
  box-shadow: 0 18px 40px rgba(130, 80, 20, 0.08);
  border-radius: 28px;
  margin-bottom: 28px;
  align-items: center;
}

.title {
  font-size: 2.4rem;
  font-weight: 900;
  margin: 0;
  color: #3f2d14;
}

.statsCard {
  display: flex;
  gap: 18px;
  flex-wrap: wrap;
  align-items: center;
}

.statLabel {
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: #8f6d24;
  margin-bottom: 4px;
}

.statsCard > div {
  background: #ffebc0;
  border-radius: 18px;
  padding: 16px 20px;
  min-width: 130px;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.6);
  text-align: center;
}

.statsCard strong {
  display: block;
  font-size: 1.8rem;
  color: #3a2406;
}

/* Form for creating new tables */
.form {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-bottom: 24px;
  background: #fff;
  padding: 24px;
  border-radius: 24px;
  box-shadow: 0 18px 50px rgba(157, 118, 15, 0.08);
  border: 1px solid rgba(226, 181, 79, 0.16);
}

.formTitle {
  margin: 0;
  font-size: 1.3rem;
  color: #3f2d14;
  font-weight: 700;
}

.formGrid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 16px;
}

.form input,
.form select {
  padding: 14px 16px;
  border-radius: 14px;
  border: 1px solid #f0d59b;
  background: #fffaf0;
  color: #3d2a12;
  outline: none;
  font-size: 0.95rem;
}

.form input:focus,
.form select:focus {
  border-color: #e2a500;
  box-shadow: 0 0 0 3px rgba(226, 165, 0, 0.1);
}

.submitButton {
  background: linear-gradient(135deg, #e2a500, #ffcc4d);
  border: none;
  color: #3e2404;
  padding: 14px 24px;
  border-radius: 18px;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 12px 22px rgba(191, 118, 0, 0.18);
  transition: all 0.2s ease;
  grid-column: span 1;
}

.submitButton:hover {
  transform: translateY(-2px);
  box-shadow: 0 16px 28px rgba(191, 118, 0, 0.24);
}

.contextLabel {
  margin: 0 0 8px;
  font-size: 0.82rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: #a16f10;
}

.tabs {
  display: flex;
  gap: 14px;
  margin-bottom: 24px;
}

.tabButton {
  flex: 1;
  padding: 14px 20px;
  border-radius: 18px;
  border: 1px solid transparent;
  background: #fff5d6;
  color: #60410f;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s ease;
}

.tabButton:hover {
  background: #ffe7a3;
}

.activeTab {
  background: #f7be36;
  color: #3a2406;
  box-shadow: 0 10px 24px rgba(130, 80, 20, 0.16);
}

/* Floor filter */
.filter {
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 600;
  color: #555555;
}

.filter select {
  padding: 8px 12px;
  border-radius: 10px;
  border: 1px solid #f0d59b;
  background: #fffaf0;
  color: #3d2a12;
  cursor: pointer;
}

.panelGrid {
  display: grid;
  grid-template-columns: 1.5fr 0.9fr;
  gap: 24px;
  margin-bottom: 26px;
}

.mainPanel,
.sidePanel {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.searchCard,
.timelineCard,
.upcomingCard {
  background: #ffffff;
  border-radius: 24px;
  padding: 24px;
  box-shadow: 0 18px 50px rgba(157, 118, 15, 0.08);
  border: 1px solid rgba(226, 181, 79, 0.16);
}

.searchRow {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin-bottom: 20px;
}

.searchRow label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 0.9rem;
  color: #69512f;
  font-weight: 600;
}

.searchRow input {
  width: 100%;
  padding: 14px 16px;
  border-radius: 14px;
  border: 1px solid #f0d59b;
  background: #fffaf0;
  color: #3d2a12;
  outline: none;
}

.peopleControl {
  min-width: 160px;
}

.peopleInput {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  background: #fff8e1;
  border: 1px solid #f1d296;
  border-radius: 14px;
  padding: 10px 12px;
  gap: 12px;
}

.peopleInput button {
  width: 34px;
  height: 34px;
  border-radius: 12px;
  border: none;
  background: #ffd271;
  color: #462e07;
  cursor: pointer;
  font-size: 1.1rem;
  transition: all 0.2s;
}

.peopleInput button:hover {
  background: #ffcc4d;
}

.peopleInput span {
  min-width: 24px;
  text-align: center;
  font-weight: 700;
}

.primaryButton {
  background: linear-gradient(135deg, #e2a500, #ffcc4d);
  border: none;
  color: #3e2404;
  padding: 14px 24px;
  border-radius: 18px;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 12px 22px rgba(191, 118, 0, 0.18);
  align-self: flex-start;
  transition: all 0.2s ease;
}

.primaryButton:hover {
  transform: translateY(-2px);
}

.floorSummary {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 16px;
  padding: 18px 22px;
  border-radius: 20px;
  background: #fff4d1;
  color: #5e4320;
  font-size: 0.95rem;
}

.floorSummary p {
  margin: 0;
  font-weight: 600;
}

.floorSummary span {
  color: #7b6428;
  font-size: 0.88rem;
}

.floorGrid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
  gap: 18px;
}

.tableCard {
  display: grid;
  gap: 10px;
  padding: 18px;
  border-radius: 24px;
  border: 1px solid transparent;
  background: #fff7e7;
  color: #432f15;
  text-align: left;
  position: relative;
}

.tableCard:hover {
  box-shadow: 0 16px 30px rgba(145, 89, 9, 0.12);
}

.tableNumber {
  font-size: 1.5rem;
  font-weight: 900;
}

.tableLabel {
  font-size: 0.9rem;
  color: #795e31;
}

.tableCustomer {
  font-size: 0.85rem;
  color: #6b5333;
  font-weight: 600;
}

.statusPill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px 10px;
  border-radius: 999px;
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  width: fit-content;
}

.deleteButton {
  padding: 6px 12px;
  border-radius: 12px;
  border: none;
  background: #ffe6b6;
  color: #a36400;
  font-size: 0.8rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s;
}

.deleteButton:hover {
  background: #ffd58d;
}

.available {
  border-color: #f9ddb1;
}

.available .statusPill {
  background: #fff4d6;
  color: #9e761a;
}

.booked {
  border-color: #f8d0a7;
}

.booked .statusPill {
  background: #ffe6b6;
  color: #a36400;
}

.arrived {
  border-color: #f4c781;
}

.arrived .statusPill {
  background: #ffd58d;
  color: #7d5200;
}

.complete {
  border-color: #e8d7b9;
}

.complete .statusPill {
  background: #f6e1b7;
  color: #6f4e1f;
}

.timelineHeader,
.upcomingHeader {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14px;
  margin-bottom: 18px;
}

.timelineHeader h2 {
  margin: 0;
  font-size: 1.55rem;
  color: #3f2c13;
}

.timelineTableWrapper {
  overflow-x: auto;
}

.timelineTable {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0 10px;
}

.timelineTable th,
.timelineTable td {
  padding: 14px 16px;
  text-align: left;
  font-size: 0.95rem;
}

.timelineTable th {
  color: #6f511b;
  font-weight: 700;
}

.timelineTable tbody tr {
  background: #fff9eb;
  border-radius: 18px;
}

.timelineTable tbody tr td {
  border-bottom: none;
}

.sidePanel {
  min-width: 280px;
}

.upcomingCard input {
  width: 100%;
  padding: 14px 16px;
  border-radius: 16px;
  border: 1px solid #f0d59b;
  background: #fffaf0;
  color: #4c3720;
  outline: none;
}

.upcomingList {
  display: grid;
  gap: 14px;
  margin-top: 16px;
}

.upcomingItem {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  padding: 16px 18px;
  border-radius: 18px;
  background: #fff6de;
  border: 1px solid rgba(238, 176, 22, 0.18);
}

.upcomingTime {
  margin: 0 0 4px;
  font-weight: 700;
  font-size: 0.95rem;
}

.upcomingName {
  margin: 0;
  color: #5a4321;
  font-size: 0.9rem;
}

.upcomingMeta {
  font-size: 0.88rem;
  font-weight: 700;
  color: #704f1e;
  align-self: center;
}

.emptyState {
  padding: 32px;
  border-radius: 20px;
  background: #fff8e5;
  text-align: center;
  color: #7b5c2f;
  font-size: 0.95rem;
}

@media (max-width: 1120px) {
  .panelGrid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 768px) {
  .headerCard,
  .searchCard,
  .timelineCard,
  .upcomingCard,
  .form {
    padding: 22px;
  }

  .tabs {
    flex-direction: column;
  }

  .searchRow {
    grid-template-columns: 1fr;
  }

  .formGrid {
    grid-template-columns: 1fr;
  }

  .submitButton {
    grid-column: 1;
  }

  .peopleInput {
    justify-content: space-between;
  }
}
